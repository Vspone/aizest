---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');

// Counted live so these numbers can't drift again
const editorialPages = Object.keys(import.meta.glob('/src/pages/*.astro')).filter(
  (p) => !/\/(index|about|how-we-review|contact|privacy|terms|404|disclosure|editorial-policy)\.astro$/.test(p)
);

const categories = ['Writing', 'Image', 'Video', 'Audio', 'Coding', 'Marketing', 'Productivity', 'Data', 'Design', 'Business'];

const author = {
  name: 'AI Zest',
  role: 'Independent AI Tools Research',
  bio: 'AI Zest is a solo-operated site covering AI tools for content creators — AI voice generation, AI avatar video, and short-form video editing. Every price, plan limit and feature claim is taken from the vendor\'s own documentation and dated, so you can see when it was last checked and go verify it yourself.',
  approach: 'Each tool is compared on what the vendor actually documents: plan tiers, usage caps, export restrictions, watermark rules and which features unlock at which price. Where a claim depends on published samples or user reports, we attribute the source instead of presenting it as our own measurement. We do not run private benchmarks, and we do not publish invented test results or hands-on scores we cannot show you evidence for.',
  contact: 'Have questions, corrections, or a tool suggestion? ',
};

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  description: author.bio,
  url: 'https://aizest.net/author/aizest',
  knowsAbout: ['AI Voice Generation', 'AI Avatar Video', 'AI Video Editing', 'AI Tools'],
  worksFor: { '@type': 'Organization', name: 'AI Zest', url: 'https://aizest.net' },
});
---

<BaseLayout
  title="About the Editor — How AI Zest Reviews Are Made"
  description="AI Zest is a solo-operated, independent guide to AI tools for content creators. Here is exactly how our reviews are researched, sourced and dated."
  canonical="/author/aizest"
  jsonLd={jsonLd}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#3B82F6]">Home</a>
      <span>/</span>
      <span class="text-gray-900 dark:text-white font-medium">Author</span>
    </nav>

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Author Header -->
    <div class="mb-10">
      <div class="flex items-center gap-5 mb-6">
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[#3B82F6] to-[#8B5CF6] flex items-center justify-center text-white text-2xl font-bold shrink-0">
          AZ
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">{author.name}</h1>
          <p class="text-gray-500 dark:text-gray-400 mt-1">{author.role}</p>
        </div>
      </div>
      <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{author.bio}</p>
    </div>

    <!-- Review Approach -->
    <div class="mb-10 p-6 rounded-xl bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">How We Review Tools</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{author.approach}</p>
      <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mt-3">
        Read the full breakdown on <a href="/how-we-review" class="text-[#3B82F6] hover:underline">our review process</a> and
        <a href="/editorial-policy" class="text-[#3B82F6] hover:underline">editorial policy</a>.
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      <div class="p-5 rounded-xl bg-gradient-to-br from-cyan-50 to-blue-50 dark:from-cyan-900/10 dark:to-blue-900/10 border border-gray-200 dark:border-gray-700 text-center">
        <div class="text-2xl font-bold text-[#3B82F6]">{tools.length}+</div>
        <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">AI Tools Covered</div>
      </div>
      <div class="p-5 rounded-xl bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/10 dark:to-pink-900/10 border border-gray-200 dark:border-gray-700 text-center">
        <div class="text-2xl font-bold text-[#8B5CF6]">{editorialPages.length}+</div>
        <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Reviews & Comparisons</div>
      </div>
      <div class="p-5 rounded-xl bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-900/10 dark:to-teal-900/10 border border-gray-200 dark:border-gray-700 text-center">
        <div class="text-2xl font-bold text-emerald-600">{categories.length}</div>
        <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Categories Covered</div>
      </div>
    </div>

    <!-- Trust & Transparency -->
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Trust & Transparency</h2>
      <div class="space-y-3 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
        <p><strong>Affiliate Disclosure:</strong> Some links on AI Zest are affiliate links. If you purchase a tool through these links, we may earn a commission at no extra cost to you. Commission never buys a ranking, a rating, or a softened verdict.</p>
        <p><strong>AI Assistance:</strong> We use AI tools to assist with research and drafting, but every article is reviewed, edited, and approved by a human before publication.</p>
        <p><strong>Editorial Independence:</strong> Rankings are based on documented facts — pricing, plan limits, feature gates and cited user reports. No tool can pay for a better rating or placement, and we say so on the page when a limit we'd rather not mention exists.</p>
        <p><strong>Corrections:</strong> Prices and features change. Every page carries the date its data was last verified. If you spot something stale, tell us and we'll fix it.</p>
      </div>
    </div>

    <!-- Contact -->
    <div class="p-6 rounded-xl bg-gradient-to-br from-[#3B82F6]/5 to-[#8B5CF6]/5 dark:from-[#3B82F6]/10 dark:to-[#8B5CF6]/10 border border-gray-200 dark:border-gray-700">
      <p class="text-sm text-gray-600 dark:text-gray-400">{author.contact}<a href="/contact" class="text-[#3B82F6] hover:underline">Get in touch →</a></p>
    </div>

  </div>
</BaseLayout>
