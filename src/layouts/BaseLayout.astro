---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: string;
}

const { title, description, canonical, ogImage, type = 'website', jsonLd } = Astro.props;
// GA4 is opt-in and consent-gated: PUBLIC_GA_ID is read inside CookieConsent.astro.
// No analytics script is emitted here — nothing loads until the visitor agrees.
---

<!doctype html>
<html lang="en">
  <head>
    <SEO 
      title={title} 
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      jsonLd={jsonLd}
    />
    <meta name='impact-site-verification' value='9b766bae-75cf-4394-8511-e412b649b5ba'>
    <noscript>
      <style>
        /* Scroll-reveal sections default to opacity:0 and depend on JS.
           Without JS the whole page below the fold would be invisible. */
        .reveal-on-scroll, .stagger-grid > *, .stagger-children > * {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
</head>
  <body class="min-h-screen flex flex-col bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script is:inline>
      // Outbound CTA click tracking. Only fires once the visitor has consented
      // to analytics — CookieConsent.astro defines window.gtag at that point.
      // Before consent no event is recorded at all.
      (function () {
        document.addEventListener('click', function (e) {
          if (typeof window.gtag !== 'function') return;
          var a = e.target && e.target.closest ? e.target.closest('a[data-cta]') : null;
          if (!a) return;
          window.gtag('event', 'cta_click', {
            tool_name: a.getAttribute('data-cta') || '',
            cta_location: a.getAttribute('data-cta-loc') || 'unknown',
            page_path: window.location.pathname,
            link_url: a.href,
            is_affiliate: a.getAttribute('data-affiliate') === 'true' ? 'yes' : 'no'
          });
        }, true);
      })();
    </script>
  </body>
</html>
