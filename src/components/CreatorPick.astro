---
import { getCollection } from 'astro:content';

export interface Props {
  slug: string;
  tagline: string;
  highlights: string[];
  badge?: string;
  reviewUrl: string;
  ctaText?: string;
  loc?: string;
}

const { slug, tagline, highlights, badge, reviewUrl, ctaText = 'Try Free', loc = 'home-pick' } = Astro.props;
const tools = await getCollection('tools');
const tool = tools.find(t => t.data.slug === slug);
if (!tool) throw new Error(`CreatorPick: unknown tool slug "${slug}"`);

const { name, pricing, rating, category, affiliate_url, affiliate = false } = tool.data;
const url = affiliate_url || '';
const rel = affiliate ? 'sponsored nofollow noopener noreferrer' : 'noopener noreferrer';
const initials = name.split(' ').slice(0, 2).map(w => w[0]).join('').toUpperCase().slice(0, 2);
const accents: Record<string, string> = {
  video: 'from-pink-500 to-rose-600',
  audio: 'from-emerald-500 to-teal-600',
  writing: 'from-blue-500 to-indigo-600',
};
const accent = accents[category] || 'from-[#3B82F6] to-[#8B5CF6]';
---

<article class="flex flex-col rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 hover:border-[#3B82F6]/40 hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
  <div class="flex items-start justify-between gap-3 mb-4">
    <div class="flex items-center gap-3 min-w-0">
      <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${accent} flex items-center justify-center text-white font-bold shrink-0`}>
        {initials}
      </div>
      <div class="min-w-0">
        <h3 class="font-bold text-lg text-gray-900 dark:text-white truncate">{name}</h3>
        <div class="flex items-start gap-1.5 text-xs text-gray-500 dark:text-gray-400">
          <span class="text-yellow-500 shrink-0">★</span><span class="shrink-0">{rating}</span>
          <span class="text-gray-300 dark:text-gray-600 shrink-0">|</span>
          <span class="leading-snug">{pricing}</span>
        </div>
      </div>
    </div>
    {badge && (
      <span class="shrink-0 text-[10px] font-semibold uppercase tracking-wide px-2 py-1 rounded-full bg-[#3B82F6]/10 text-[#3B82F6] dark:bg-[#3B82F6]/20">
        {badge}
      </span>
    )}
  </div>

  <p class="text-sm text-gray-600 dark:text-gray-400 mb-4 leading-relaxed">{tagline}</p>

  <ul class="text-sm text-gray-700 dark:text-gray-300 space-y-1.5 mb-5">
    {highlights.map(h => (
      <li class="flex gap-2"><span class="text-emerald-500 shrink-0">✓</span><span>{h}</span></li>
    ))}
  </ul>

  <div class="mt-auto flex flex-wrap items-center gap-3">
    {url && (
      <a href={url} target="_blank" rel={rel}
         data-cta={name} data-cta-loc={loc} data-affiliate={affiliate ? 'true' : 'false'}
         class="inline-block px-5 py-2.5 rounded-lg bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700 transition-colors">
        {ctaText} ↗
      </a>
    )}
    <a href={reviewUrl} class="text-sm font-medium text-[#3B82F6] hover:underline">
      Read review →
    </a>
  </div>
</article>
