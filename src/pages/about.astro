---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');

// Editorial pages counted live so the About stats never go stale
const editorialPages = Object.keys(import.meta.glob('/src/pages/*.astro')).filter(
  (p) => !/\/(index|about|how-we-review|contact|privacy|terms|404|disclosure|editorial-policy)\.astro$/.test(p)
);

const categories = [
  { name: 'Writing & Content', icon: '✍️', slug: 'writing' },
  { name: 'Image Generation', icon: '🎨', slug: 'image' },
  { name: 'Video Creation', icon: '🎬', slug: 'video' },
  { name: 'Audio & Voice', icon: '🎵', slug: 'audio' },
  { name: 'Coding & Dev', icon: '💻', slug: 'coding' },
  { name: 'Marketing & SEO', icon: '📈', slug: 'marketing' },
  { name: 'Productivity', icon: '⚡', slug: 'productivity' },
  { name: 'Data & Analytics', icon: '📊', slug: 'data' },
  { name: 'Design & Creative', icon: '🎯', slug: 'design' },
  { name: 'Business & Finance', icon: '💼', slug: 'business' },
];
---

<BaseLayout 
  title="About — AI Zest" 
  description="AI Zest covers AI tools for content creators — honest reviews, practical comparisons and creator workflows for voice, video and short-form."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <!-- Breadcrumb -->
    <nav class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#3B82F6] transition-colors">Home</a>
      <span>/</span>
      <span class="text-gray-900 dark:text-white font-medium">About</span>
    </nav>

    <!-- Hero section -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-[#3B82F6] to-[#8B5CF6] text-white text-2xl mb-4">
        ⚡
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-3">
        About <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#3B82F6] to-[#8B5CF6]">AI Zest</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
        An independent guide to AI tools for content creators — honest reviews, practical comparisons, and the workflows that actually ship finished video, voice, and short-form content.
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 text-center">
        <div class="text-2xl sm:text-3xl font-bold text-[#3B82F6]">{tools.length}+</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">AI Tools Covered</div>
      </div>
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 text-center">
        <div class="text-2xl sm:text-3xl font-bold text-[#8B5CF6]">{categories.length}</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Categories</div>
      </div>
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 text-center">
        <div class="text-2xl sm:text-3xl font-bold text-[#3B82F6]">{editorialPages.length}+</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Reviews & Comparisons</div>
      </div>
    </div>

    <!-- Mission section -->
    <div class="mb-12">
      <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-8 sm:p-10">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
          <span>🎯</span> Why AI Zest Exists
        </h2>
        <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
          Content creators are drowning in AI tool lists. Most of them are written to rank, not to help — a hundred
          tools in a grid, no pricing you can trust, no answer to the only question that matters: <em>does this fit
          how I actually work?</em>
        </p>
        <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
          AI Zest is built around a narrower question. We focus on the tools that carry the weight of a creator's
          workflow — AI voice generation, AI avatar video, and short-form video editing — and we go deeper on those
          instead of cataloguing everything that launches each week.
        </p>
        <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
          That means real pricing tables with the annual-vs-monthly difference spelled out, plan-limit comparisons that
          decide whether a tool is usable at your volume, and side-by-sides that tell you when the cheaper option is
          genuinely enough. Every price we publish is checked against the vendor's own pricing page, with the date it
          was last verified on the page.
        </p>
      </div>
    </div>

    <!-- Focus areas -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
        <span>🎬</span> What We Focus On
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/best-ai-voice-generators-2026" class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 hover:border-[#3B82F6]/40 transition-all duration-200 tap-feedback block">
          <div class="text-2xl mb-2">🎙️</div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-1">AI Voice Generation</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Voiceover for faceless video, audiobooks, podcasts, and localization — with the character and commercial-rights limits of each plan.</p>
        </a>
        <a href="/best-ai-avatar-video-generators-2026" class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 hover:border-[#3B82F6]/40 transition-all duration-200 tap-feedback block">
          <div class="text-2xl mb-2">🧑‍💻</div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-1">AI Avatar Video</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Talking-head explainers and course content without a camera — plus which plans actually unlock custom avatars.</p>
        </a>
        <a href="/best-ai-video-editors-for-shorts-2026" class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 hover:border-[#3B82F6]/40 transition-all duration-200 tap-feedback block">
          <div class="text-2xl mb-2">✂️</div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Short-Form Video Editing</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Captions, auto-cuts, and clip repurposing for TikTok, Reels, and Shorts — measured by export watermark and per-project limits.</p>
        </a>
      </div>
    </div>

    <!-- How we review -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
        <span>🔍</span> How We Review
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 flex items-start gap-4">
          <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0 text-lg">✓</div>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Feature Accuracy</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Every capability claim is checked against the vendor's documentation, not their marketing copy.</p>
          </div>
        </div>
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 flex items-start gap-4">
          <div class="w-10 h-10 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400 shrink-0 text-lg">$</div>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Pricing & Value</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Honest assessment of whether a tool is worth its price.</p>
          </div>
        </div>
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 flex items-start gap-4">
          <div class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-green-600 dark:text-green-400 shrink-0 text-lg">👤</div>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Ease of Use</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">How many steps and how much setup stand between you and a finished asset.</p>
          </div>
        </div>
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 flex items-start gap-4">
          <div class="w-10 h-10 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-600 dark:text-amber-400 shrink-0 text-lg">⚡</div>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Output Quality</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Judged from the vendor's published samples, documented specs, and what users report — never invented.</p>
          </div>
        </div>
      </div>
      <div class="text-center mt-6">
        <a href="/how-we-review" class="text-sm text-[#3B82F6] hover:underline inline-flex items-center gap-1">
          Read our full review methodology →
        </a>
      </div>
    </div>

    <!-- About the Editor -->
    <div class="mb-12">
      <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-8 sm:p-10">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
          <span>✍️</span> About the Editor
        </h2>
        <div class="flex flex-col sm:flex-row items-start gap-5">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#3B82F6] to-[#8B5CF6] flex items-center justify-center text-white text-2xl shrink-0">
            V
          </div>
          <div>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-3">
              AI Zest is run by a solo operator with a simple constraint: <strong>we would rather publish a page that is useful and truthful than one that pretends to be a lab test.</strong> So here is exactly what a review on this site is, and is not.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-3">
              <strong>What it is:</strong> every plan tier, price, and usage limit is pulled from the vendor's own pricing and documentation pages, then re-checked and dated. Comparisons are built on those documented facts — how many minutes of video a plan gives you, whether a watermark appears on export, which tier unlocks custom avatars or professional voice cloning. Where public samples and user reports bear on quality, we say so and attribute it.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-3">
              <strong>What it is not:</strong> we do not claim to have personally run every tool through a private benchmark, and we don't publish invented timings, invented side-by-side experiments, or a "hands-on score" we can't substantiate. If a claim isn't checkable against a vendor page or a cited source, it doesn't go on the site.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-3">
              Affiliate links help pay for this work, and they never buy a ranking, a rating, or a softened verdict. If a tool we earn from has a real limitation, the limitation is written on the page.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              Spotted something out of date or wrong? <a href="mailto:admin@aizest.net" class="text-[#3B82F6] hover:underline">Tell us</a> and we'll correct it — corrections are the point, not an embarrassment.
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
        <span>📂</span> The Full Directory
      </h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-6">
        Creator tools are where we go deep. The rest of the directory stays online as a reference — same detail on
        pricing and plan limits, just less editorial depth.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}`} 
             class="flex items-center gap-3 p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:border-[#3B82F6]/40 dark:hover:border-[#3B82F6]/40 transition-all duration-200 tap-feedback">
            <span class="text-lg">{cat.icon}</span>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{cat.name}</span>
            <svg class="w-4 h-4 text-gray-400 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Contact section -->
    <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-gradient-to-br from-[#3B82F6]/5 to-[#8B5CF6]/5 dark:from-[#3B82F6]/10 dark:to-[#8B5CF6]/10 p-8 sm:p-10 text-center mb-8">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white dark:bg-gray-800 shadow-sm mb-4">
        <svg class="w-6 h-6 text-[#3B82F6]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Get in Touch</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4 max-w-md mx-auto">
        Have a question, suggestion, or want to submit a tool for review? We'd love to hear from you.
      </p>
      <a href="mailto:admin@aizest.net" class="inline-flex items-center gap-2 btn-primary text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        admin@aizest.net
      </a>
    </div>

    <!-- Disclaimer -->
    <div class="text-xs text-gray-400 dark:text-gray-500 leading-relaxed text-center">
      <p>Some links on this website are affiliate links. If you click through and make a purchase, we may earn a small commission at no extra cost to you. This helps us maintain and grow AI Zest. Our reviews remain unbiased — we only recommend tools we genuinely believe in.</p>
    </div>

  </div>
</BaseLayout>
