---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — AI Zest"
  description="The page you were looking for does not exist. Browse our AI tool reviews, comparisons, and roundups instead."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <p class="text-sm font-semibold text-[#3B82F6] uppercase tracking-wider mb-3">404</p>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4">Page not found</h1>
    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-8">
      The page you requested does not exist, or it may have been renamed or retired. If you followed a link from another site, that link is probably out of date.
    </p>

    <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 sm:p-8 mb-8">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Where to go next</h2>
      <ul class="grid sm:grid-cols-2 gap-2 text-sm">
        <li><a href="/" class="text-[#3B82F6] hover:underline">Home — featured AI tools</a></li>
        <li><a href="/category/writing" class="text-[#3B82F6] hover:underline">Browse all categories</a></li>
        <li><a href="/compare" class="text-[#3B82F6] hover:underline">Compare tools side by side</a></li>
        <li><a href="/alternatives/" class="text-[#3B82F6] hover:underline">Find alternatives</a></li>
        <li><a href="/how-we-review" class="text-[#3B82F6] hover:underline">How we review</a></li>
        <li><a href="/contact" class="text-[#3B82F6] hover:underline">Contact us</a></li>
      </ul>
    </div>

    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
      Looking for a specific tool? Try the search box in the site header, or <a href="/contact" class="text-[#3B82F6] hover:underline">tell us</a> what you were trying to find and we will point you at the right page.
    </p>
  </div>
</BaseLayout>
